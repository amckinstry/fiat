MODULE MPL_SEND_MOD

#! type: (kind, scalar, not_contiguous, datatype , dimension, icommtype )
#:set vdef = { &
      & 'REAL4' : ('REAL(KIND=JPRM)', False, '0', 'MPI_REAL4', 1 ,'M' ), &
      & 'REAL8' : ('REAL(KIND=JPRD)', False, '8', 'INT(MPI_REAL8)', 1, 'I'  ), &
      & 'INT'  : ('INTEGER(KIND=JPIM)',False, '4', 'INT(MPI_INTEGER)', 1,'I' ),  &
      & 'INT2' : ('INTEGER(KIND=JPIM)',False, '4', 'INT(MPI_INTEGER)' 2, 'I' ), &
      & 'INT8' : ('INTEGER(KIND=JPIB)',False, '8', 'INT(MPI_INTEGER8)',1,'I' ), &
      & 'INT_SCALAR' : ('INTEGER(KIND=JPIM)', True,  4, 'INT(MPI_INTEGER)',0,'I'), &
      & 'REAL42' : ('REAL(KIND=JPRM)', False, '42', 'INT(MPI_REAL4)', 2, 'I'),&
      & 'REAL82' : ('REAL(KIND=JPRD)', False, '82', 'INT(MPI_REAL8)', 2, 'I'  ), &
      & 'REAL43' : ('REAL(KIND=JPRM)',False, '43', 'INT(MPI_REAL4)', 3, 'I'),&
      & 'REAL83' : ('REAL(KIND=JPRD)', False, '83', 'INT(MPI_REAL8)', 3, 'I'  ), &
      & 'REAL4_SCALAR' : ('REAL(KIND=JPRM)', True, '4', 'INT(MPI_REAL4)', 0, 'I'),&
      & 'REAL8_SCALAR' : ('REAL(KIND=JPRD)', True, '8', 'INT(MPI_REAL8)', 0, 'I'  ), &
      & 'CHAR_SCALAR' : ('CHARACTER(LEN=*)', True, '8', 'INT(MPI_BYTE)',0,'I'), &
      & 'CHAR' : ('CHARACTER(LEN=*)','-1', True, 'INT(MPI_BYTE); 1, 'I'), &
      &   }       

#:set types = ['REAL4','REAL8','INT','INT2', 'INT8', 'INT_SCALAR','REAL42','REAL43','REAL82','CHAR_SCALAR','CHAR','REAL4_SCALAR','REAL8_SCALAR','REAL83' ]

#:def kind(type)
  $vdef[type][0]$
#:enddef

#:def not_contiguous(type)
#:set typ { '0' : '.not. IS_CONTIGUOUS(PBUF)', &
      &      '4': '(LOC(PBUF(UBOUND(PBUF,1))) - &
      &             LOC(PBUF(LBOUND(PBUF,1)))) /= 4_JPIB*(ICOUNT - 1))',&
      &      '8': '(LOC(PBUF(UBOUND(PBUF,1))) - &
      &             LOC(PBUF(LBOUND(PBUF,1)))) /= 8_JPIB*(ICOUNT - 1)' }, &
      &     '42': '(LOC(PBUF(UBOUND(PBUF,1),UBOUND(PBUF,2))) - &
      &              LOC(PBUF(LBOUND(PBUF,1),LBOUND(PBUF,2)))) &
      &             /= 4_JPIB*(ICOUNT - 1) )', &
      &     '82': '(LOC(PBUF(UBOUND(PBUF,1),UBOUND(PBUF,2))) - &
      &             LOC(PBUF(LBOUND(PBUF,1),LBOUND(PBUF,2)))) &
      &             /= 8_JPIB*(ICOUNT - 1) )', &
      &      '43': '(LOC(PBUF(UBOUND(PBUF,1),UBOUND(PBUF,2),UBOUND(PBUF,3))) - &
      &              LOC(PBUF(LBOUND(PBUF,1),LBOUND(PBUF,2),LBOUND(PBUF,3)))) &
      &              /= 4_JPIB*(ICOUNT - 1) )', &
      &      '73': '(LOC(PBUF(UBOUND(PBUF,1),UBOUND(PBUF,2),UBOUND(PBUF,3))) - &
      &              LOC(PBUF(LBOUND(PBUF,1),LBOUND(PBUF,2),LBOUND(PBUF,3)))) &
      &              /= _JPIB*(ICOUNT - 1) )', &
      & }
      
$typ[vdef[type][1]]$
#:enddef
 
#:def datatype(type)
  $vdef[type][2]$
#:endif

#:def dim(type)
  #: set typ = {'0': '', '1': 'DIMENSION(:)','2':'DIMENSION(:,:)' }
  $typ[vdef[type][4]]$
#:enddef

#:def icommtype(type)
#: set typ = {'M' : 'TYPE(MPI_COMM) , 'I' : 'INTEGER(KIND=JPIM) ' }
 $typ[vdef[type][5]]$
#:enddef      

#:def icomm(type)
#: set typ = { 'M' : 'ICOMM%MPI_VAL', 'I': 'ICOMM' }
 $typ[vdef[type][5]]$
#:enddef

#: def attr(suffix)
#:set typ { '' : '', '_DEVICE': ',DEVICE' }
     $typ[suffix]$
#:endif
      
!**** MPL_SEND Send a message

!     Purpose.
!     --------
!     Send a message to a named source from a buffer.
!     The data may be REAL*4, REAL*8,or INTEGER, one dimensional array
!                     REAL*4,or REAL*8, two dimensional array
!                  or INTEGER scalar

!**   Interface.
!     ----------
!        CALL MPL_SEND

!        Input required arguments :
!        -------------------------
!           PBUF     -  buffer containing message
!                       (can be type REAL*4, REAL*8 or INTEGER)
!           KTAG     -  message tag
!           KDEST    -  rank of process to receive the message

!        Input optional arguments :
!        -------------------------
!           KCOMM    -  Communicator number if different from MPI_COMM_WORLD 
!                       or from that established as the default 
!                       by an MPL communicator routine
!           KMP_TYPE -  buffering type (see MPL_BUFFER_METHOD)
!                       overrides value provided to MPL_BUFFER_METHOD
!           CDSTRING -  Character string for ABORT messages
!                       used when KERROR is not provided

!        Output required arguments :
!        -------------------------
!           none

!        Output optional arguments :
!        -------------------------
!           KREQUEST -  Communication request
!                       required when buffering type is non-blocking
!           KERROR   -  return error code.     If not supplied, 
!                       MPL_SEND aborts when an error is detected.
!     Author.
!     -------
!        D.Dent, M.Hamrud     ECMWF

!     Modifications.
!     --------------
!        Original: 2000-09-01
!        P. Marguinaud : 01-Jan-2011 : Do not raise an error when
!                        the numproc is beyond model limits and KCOMM is passed
!                        as argument
!      F. Vana  05-Mar-2015  Support for single precision
!     ------------------------------------------------------------------

USE EC_PARKIND , ONLY : JPRD, JPIM, JPIB, JPRM
USE OML_MOD   ,ONLY : OML_MY_THREAD

USE MPL_MPI,         ONLY : MPI_COMM, MPI_REQUEST, MPI_REAL4, MPI_REAL8, MPI_INTEGER, MPI_INTEGER8, MPI_BYTE
USE MPL_DATA_MODULE, ONLY : MPL_OUTPUT, MPL_COMM_OML, MPL_ERRUNIT, MPL_UNIT, MPL_METHOD, MPL_NUMPROC, &
 &                          JP_BLOCKING_STANDARD, JP_BLOCKING_BUFFERED, JP_BLOCKING_SYNCHRONOUS, &
 &                          JP_NON_BLOCKING_STANDARD, JP_NON_BLOCKING_BUFFERED
USE MPL_MESSAGE_MOD, ONLY : MPL_MESSAGE
USE MPL_NPROC_MOD,   ONLY : MPL_NPROC
USE MPL_STATS_MOD,   ONLY : MPL_SENDSTATS
USE YOMMPLSTATS,     ONLY : LMPLSTATS
      
IMPLICIT NONE

      

      
INTERFACE MPL_SEND

#:for type in names
      MODULE PROCEDURE MPL_SEND_${type}$
#:endfor

#:if defined('_CUDA')      
#:for type in names
      MODULE PROCEDURE MPL_SEND_${type}$_DEVICE
#:endfor
      
END INTERFACE

PRIVATE

!---Moved into subroutines to keep threadsafe----
! INTEGER(KIND=JPIM) :: ICOUNT,IMP_TYPE,ICOMM,IERROR
! LOGICAL :: LLABORT=.TRUE.

PUBLIC MPL_SEND

CONTAINS


#: for suffix in ['', '_DEVICE']      

#: for type in types
      
SUBROUTINE MPL_SEND_${type}${suffix}$(PBUF,KDEST,KTAG,KCOMM,KMP_TYPE,KERROR,KREQUEST,CDSTRING)

#:if defined('USE_8_BYTE_WORDS')      
  USE MPI4TO8, ONLY : &
    MPI_SEND => MPI_SEND8, MPI_BSEND => MPI_BSEND8, MPI_ISEND => MPI_ISEND8
#:endif

! real_m,intent(in) :: PBUF(:)
${kind(type)}$  ${attr(suffix)}$ ${dim(type)}$      :: PBUF(:)
INTEGER(KIND=JPIM),INTENT(IN) :: KDEST,KTAG
INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL :: KCOMM,KMP_TYPE
INTEGER(KIND=JPIM),INTENT(OUT),OPTIONAL :: KREQUEST,KERROR
CHARACTER(LEN=*),INTENT(IN),OPTIONAL :: CDSTRING


INTEGER(KIND=JPIM) :: ICOUNT,IMP_TYPE,IERROR
LOGICAL :: LLABORT=.TRUE.
INTEGER(KIND=JPIM) :: ITID
${icommtype(type)}$ :: ICOMM
${kind(type)}$    :: DUM(1:0)
ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE( &
  & CDMESSAGE='MPL_SEND: MPL NOT INITIALISED ',LDABORT=LLABORT) 
  
IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF
IF(PRESENT(KCOMM)) THEN
  ${icomm(type)}$=KCOMM
ELSE
  ${icomm(type)}$=MPL_COMM_OML(ITID)
ENDIF
IF((KDEST < 1 .OR. KDEST >MPL_NPROC(${icomm(type)}$)) .AND. (.NOT. PRESENT (KCOMM))) THEN
  WRITE(MPL_ERRUNIT,*)'MPL_SEND: ERROR KDEST=',KDEST
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND:ILLEGAL KDEST ',LDABORT=LLABORT)
ENDIF

ICOUNT = SIZE(PBUF)
#:if not scalar(type)
#:if defined('MPL_CHECK_CONFIG') or not defined('NAGFOR')
IF( ${not_contiguous(type)}$ ) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND: BUFFER NOT CONTIGUOUS ',LDABORT=LLABORT)
ENDIF
#:endif
#:endif

IF(LMPLSTATS) THEN
#! TODO check
#:if type == 'REAL4'
      CALL MPL_SENDSTATS(ICOUNT, MPI_REAL4%MPI_VAL)
#:else      
      CALL MPL_SENDSTATS(ICOUNT,${datatype(type)}$)
#:endif      
ENDIF

IF (ICOUNT == 0) THEN
  IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
    CALL MPI_SEND(DUM,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
    CALL MPI_BSEND(DUM,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
# TODO CHECK
#:if type == 'REAL4'
      CALL MPI_ISEND(DUM,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
#:else
      CALL MPI_ISEND(DUM,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM, &
      & KREQUEST,IERROR)
#:endif     
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
#! TODO Check
#:if type == 'REAL4'`
    CALL MPI_IBSEND(DUM,ICOUNT,MPI_REAL4,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
#:else
    CALL MPI_IBSEND(DUM,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM, &
      & KREQUEST,IERROR)
#:endif      
  ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
    CALL MPI_SSEND(DUM,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE
    IF(PRESENT(KERROR)) THEN
      KERROR=1
    ELSE
      CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
    ENDIF
  ENDIF
ELSE
  IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
    CALL MPI_SEND(PBUF,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
    CALL MPI_BSEND(PBUF,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
#:if type == 'REAL4'         
    CALL MPI_ISEND(PBUF,ICOUNT,MPI_REAL4,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
    CALL MPI_IBSEND(PBUF,ICOUNT,MPI_REAL4,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
#:else      
`    CALL MPI_ISEND(PBUF(1),ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM, &
      & KREQUEST,IERROR)
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
    CALL MPI_IBSEND(PBUF(1),ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM, &
      & KREQUEST,IERROR)
#:endif      
  ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
    CALL MPI_SSEND(PBUF,ICOUNT,${datatype(type)}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE
    IF(PRESENT(KERROR)) THEN
      KERROR=1
    ELSE
      CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
    ENDIF
  ENDIF
ENDIF
IF(MPL_OUTPUT > 1 )THEN
  WRITE(MPL_UNIT,'(A,5I8)') ' MPL_SEND ',ICOUNT,IMP_TYPE,KDEST,KTAG,ICOMM
ENDIF
IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF
      
END SUBROUTINE MPL_SEND_${type}${suffix}$

#:endfor


END MODULE MPL_SEND_MOD
