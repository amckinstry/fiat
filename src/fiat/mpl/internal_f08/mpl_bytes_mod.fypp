MODULE MPL_BYTES_MOD


USE EC_PARKIND, ONLY : JPIM, JPIB, JPRM, JPRD

IMPLICIT NONE

PRIVATE

PUBLIC :: MPL_BYTES

INTERFACE MPL_BYTES
#:for type in ['IM','IB','RM','RD']
   MODULE PROCEDURE MPL_BYTES_${type}$
#:endfor
END INTERFACE MPL_BYTES

CONTAINS

#:for type in ['IM','IB','RM','RD']
FUNCTION MPL_BYTES_${type}$(KVAR)
INTEGER(KIND=JP${type}$), INTENT(IN) :: KVAR
INTEGER(KIND=JPIM) MPL_BYTES_IM
MPL_BYTES_${type}$ = SIZE(TRANSFER(KVAR, (/'A'/)))
END FUNCTION MPL_BYTES_${type$}

      
END MODULE MPL_BYTES_MOD
