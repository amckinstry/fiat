MODULE MPI4TO8

#!  ranksuff: ( kind, dimension, allocate, cast, base_kind )
#:set vdef = { &      
      & '1RM' : ('REAL(KIND=JPRM)',1,True, True, 'REAL' ), &
      & '1RD' : ('REAL(KIND=JPRD)',1,False,False, 'REAL' ), &
      & '2RM' : ('REAL(KIND=JPRM)',2,True, True, 'REAL' ), &
      & '2IM' : ('INTEGER(KIND=JRPM)', 2 , True, True , 'INTEGER'), &
      & '2RD' : ('REAL(KIND=JPRD)', 2 , False, False,'REAL'), &
      & '1ID'  : ('INTEGER(KIND=JPIB)', 1, True, False,'INTEGER'), &
      & '1IM'  : ('INTEGER(KIND=JPIM)', 1, True, False,'INTEGER'), &
      & '0IM'  : ('INTEGER(KIND=JPIM)', 0, False, True,'INTEGER'), &
      & '0RM' : ('REAL(KIND=JPRM)', 0, False, True,'REAL'), &
      & '0RD' : ('REAL(KIND=JPRD)', 0, False, True,'REAL'), &
      & '0CH' : ('CHARACTER(LEN=*)', 0, False, False,'CHARACTER'), &
      & '2RM' : ('REAL(KIND=JPRM)',2,True, True,'REAL' ), &
      & '2RD' : ('REAL(KIND=JPRM)',2,True, True,'REAL' ), &
      & '0RM' : ('REAL(KIND=JPRM)',0,False,True,'REAL'), &
      & '0RD' : ('REAL(KIND=JPRD)',1,False,True,'REAL'), &
      & '0RM' : ('INTEGER(KIND=JRPM)', 1 , False, True , 'INTEGER'), &
      & '0RM' : ('INTEGER(KIND=JRPM)', 0 , False, True , 'INTEGER'), &
      & 'ORD' : ('REAL(KIND=JPRD)',0,False,True,'REAL'), &
      }

#:set sendrecv_ranksuffs = ['1RM', '1R8','2RM','2RD','0IM','1IM','0CH','2IM','0RM','0RD' ]
#:set mpifile_ranksuffs =  ['1RD','1RM']
#:set alltoallv_ranksuffs = ['1RD', '1RM']
#:set gather_ranksuffs = ['1ID','0RD'], ['I8','R8_1']
#:set allgatherv_ranksuffs = ['R4', 'R8', 'I4' ,'I1']
#:set allreduce_ranksuffs = ['R4','R8','I4','R4_2D','R8_2D' ]
#:set gatherv_ranksuffs = ['R4','R8','R4S','R8S','I4','I1','I4S','I4S_1','R8_1','R8S_1']
#:set scatterv_ranksuffs = ['R8','I4','R8S','I4S']
#:set bcast_ranksuffs = ['R4','R8','I4','I1','CH']      

#:def allocatable(ranksuff)
 #:if vdef[ranksuff][2] == True
   ALLOCATABLE
 #:endif
#:enddef
#:def dim(ranksuff)
  #: set y = vdef[ranksuff][1]
  #: set dimension = {0: '', 1: ',DIMENSION(:)',2:',DIMENSION(:,:)' }
  ${dimension[y]}$
#:enddef
#:def is_allocatable(ranksuff)
  ${vdef[ranksuff][2]}$
#:enddef      
#:def kind(ranksuff)
  ${vdef[ranksuff][0]}$
#:enddef
#:def cast(ranksuff)
  ${vdef[ranksuff][3]}$
#:enddef
#:def base_kind(ranksuff)
     ${vdef[ranksuff][4]}$
#:enddef

        
#:if defined('USE_8_BYTE_WORDS')

USE EC_PARKIND, ONLY : JPIM, JPRM, JPRD
USE MPL_MPIF

IMPLICIT NONE

PRIVATE :: STATUS8
  INTEGER(KIND=8), DIMENSION(MPI_STATUS_SIZE) :: STATUS8

INTERFACE MPI_ALLGATHERV8
#:for ranksuff in allgatherv_ranksuffs     
      MODULE PROCEDURE MPI_ALLGATHERV8_${ranksuff}$
#:endfor    
END INTERFACE MPI_ALLGATHERV8

INTERFACE MPI_ALLREDUCE8
#:for ranksuff in allreduce_ranksuffs
      MODULE PROCEDURE MPI_ALLREDUCE8_${ranksuff}$
#:endfor
END INTERFACE MPI_ALLREDUCE8

INTERFACE MPI_ALLTOALLV8
#:for ranksuff in alltoallv_ranksuffs
      MODULE PROCEDURE MPI_ALLTOALLV8_${ranksuff}$
#:endfor
END INTERFACE MPI_ALLTOALLV8

INTERFACE MPI_BCAST8
#:for ranksuff in bcast_ranksuffs
      MODULE PROCEDURE MPI_BCAST8_${ranksuff}$
#:endfor      
END INTERFACE MPI_BCAST8

#:for method in ['BSEND8', 'ISEND8','SEND8','IRECV8','RECV8']
INTERFACE MPI_${method}$
#:for ranksuff in sendrecv_ranksuffs

  MODULE PROCEDURE MPI_${method}$_${ranksuff}$
#:endfor
END INTERFACE MPI_${method}$
#:endfor

#:for method  in ['IREAD_SHARED8','IWRITE_SHARED8','READ_ORDERED8', 'READ_ORDERED_BEGIN8','READ_ORDERED_END8','READ_SHARED8','WRITE_ORDERED8','WRITE_ORDERED_BEGIN8','WRITE_ORDERED_END8','WRITE_SHARED8']
INTERFACE MPI_FILE_${method}$
#:for ranksuff in mpifile_ranksuffs
  MODULE PROCEDURE MPI_FILE_${method}$_${ranksuff}$
#:endfor
END INTERFACE MPI_FILE_${method}$
#:endfor


INTERFACE MPI_GATHER8
#:for ranksuff in gather_ranksuffs
      MODULE PROCEDURE MPI_GATHER8_${ranksuff}$
#:endfor      
END INTERFACE MPI_GATHER8

INTERFACE MPI_GATHERV8
#:for ranksuff in gatherv_ranksuffs
  MODULE PROCEDURE MPI_GATHERV8_${ranksuff}$
#:endfor
END INTERFACE MPI_GATHERV8

INTERFACE MPI_SCATTERV8
#:for ranksuff in scatterv_ranksuffs
  MODULE PROCEDURE MPI_SCATTERV8_${ranksuff}$
#:endfor
END INTERFACE MPI_SCATTERV8

PUBLIC

CONTAINS

! =========================================================

#:for ranksuff in allreduce_ranksuffs
! ---------------------------------------------------------
SUBROUTINE MPI_ALLREDUCE8_${ranksuff}$(SENDDATA, RECVDATA, COUNT, DATATYPE, OP, &
                             COMM, IERROR)

  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(IN) :: &
    SENDDATA
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    COUNT, DATATYPE, OP, COMM
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(OUT) :: &
    RECVDATA
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
    SENDDATA8, RECVDATA8
  INTEGER(KIND=8) :: &
    COUNT8, DATATYPE8, OP8, COMM8, IERROR8

#:if is_allocatable(ranksuff)
  ALLOCATE(SENDDATA8(SIZE(SENDDATA)))
  ALLOCATE(RECVDATA8(SIZE(RECVDATA)))
#:endif
#:if cast(ranksuff)
  SENDDATA8 = SENDDATA
#:endif
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE
  OP8 = OP
  COMM8 = COMM

  CALL MPI_ALLREDUCE( &
      #{if cast(ranksuff)}# SENDDATA8 #{else}# SENDDATA #{endif}#, &
      #{if cast(ranksuff)}# RECVDATA8 #{else}# RECVDATA #{endif}#, &
      COUNT8, DATATYPE8, OP8, COMM8, IERROR8)

#:if cast(ranksuff)
  RECVDATA = RECVDATA8
#:endif
  IERROR = IERROR8

#:if is_allocatable(ranksuff)
  DEALLOCATE(SENDDATA8)
  DEALLOCATE(RECVDATA8)
#:endif

END SUBROUTINE MPI_ALLREDUCE8_${ranksuff}$

! ---------------------------------------------------------
#:endfor
! =========================================================

#:for ranksuff in allgatherv_ranksuffs

SUBROUTINE MPI_ALLGATHERV8_${ranksuff}$(SENDAREA, SENDCOUNT, SENDTYPE, RECVAREA, &
      RECVCOUNTS, DISPLS, RECVTYPE, COMM, IERROR)

  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(IN) :: &
    SENDAREA
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    SENDCOUNT, SENDTYPE, RECVTYPE, COMM
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(OUT) :: &
    RECVAREA
  INTEGER(KIND=JPIM), DIMENSION(:), INTENT(IN) :: &
    RECVCOUNTS, DISPLS
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

#:if cast(ranksuff)
  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
    SENDAREA8, RECVAREA8
#:endif
  INTEGER(KIND=8), DIMENSION(:), ALLOCATABLE :: &
    RECVCOUNTS8, DISPLS8
  INTEGER(KIND=8) :: &
    SENDCOUNT8, SENDTYPE8, RECVTYPE8, COMM8, IERROR8

#:if is_allocatable(ranksuff)
  ALLOCATE(SENDAREA8(SIZE(SENDAREA)))
  ALLOCATE(RECVAREA8(SIZE(RECVAREA)))
#:endif
  ALLOCATE(RECVCOUNTS8(SIZE(RECVCOUNTS)))
  ALLOCATE(DISPLS8(SIZE(DISPLS)))

#:if cast(ranksuff)
  SENDAREA8 = SENDAREA
#:endif
  SENDCOUNT8 = SENDCOUNT
  SENDTYPE8 = SENDTYPE
  RECVCOUNTS8 = RECVCOUNTS
  DISPLS8 = DISPLS
  RECVTYPE8 = RECVTYPE
  COMM8 = COMM

  CALL MPI_ALLGATHERV( &
      #{if cast(ranksuff)}# SENDAREA8 #{else}# SENDAREA #{endif}#, &
      SENDCOUNT8, SENDTYPE8, &
      #{if cast(ranksuff)}# RECVAREA8 #{else}# RECVAREA #{endif}#, &
      RECVCOUNTS8, DISPLS8, RECVTYPE8, COMM8, IERROR8)

#:if cast(ranksuff)
  RECVAREA = RECVAREA8
#:endif
  IERROR = IERROR8

#:if is_allocatable(ranksuff)
  DEALLOCATE(SENDAREA8)
  DEALLOCATE(RECVAREA8)
#:endif
  DEALLOCATE(RECVCOUNTS8)
  DEALLOCATE(DISPLS8)

END SUBROUTINE MPI_ALLGATHERV8_${ranksuff}$

! ---------------------------------------------------------
#:endfor

! =========================================================

#:for ranksuff in alltoallv_ranksuffs

SUBROUTINE MPI_ALLTOALLV8_${ranksuff}$(SENDAREA, SENDCOUNTS, SDISPLS, SENDTYPE, &
                             RECVAREA, RECVCOUNTS, RDISPLS, RECVTYPE, &
                             COMM, IERROR)
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(IN) :: &
    SENDAREA
  INTEGER(KIND=JPIM), DIMENSION(:), INTENT(IN) :: &
    SENDCOUNTS, SDISPLS, RECVCOUNTS, RDISPLS
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    SENDTYPE, RECVTYPE, COMM
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(OUT) :: &
    RECVAREA
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

#:if cast(ranksuff)
 ${base_kind(ranksuff)}$(KIND=8) ${dim(ranksuff)}$ ${allocatable}$ :: &
    SENDAREA8, RECVAREA8
#:endif
 INTEGER(KIND=8), DIMENSION(:), ALLOCATABLE :: &
    SENDCOUNTS8, SDISPLS8, RECVCOUNTS8, RDISPLS8
  INTEGER(KIND=8) :: &
    SENDTYPE8, RECVTYPE8, COMM8, IERROR8

#:if is_allocatable(ranksuff)
  ALLOCATE(SENDAREA8(SIZE(SENDAREA)))
  ALLOCATE(RECVAREA8(SIZE(RECVAREA)))
#:endif

  ALLOCATE(SENDCOUNTS8(SIZE(SENDCOUNTS)))
  ALLOCATE(SDISPLS8(SIZE(SDISPLS)))
  ALLOCATE(RECVCOUNTS8(SIZE(RECVCOUNTS)))
  ALLOCATE(RDISPLS8(SIZE(RDISPLS)))

#:if cast(ranksuff)
  SENDAREA8 = SENDAREA
  READAREA8 = READAREA
#:endif
  SENDCOUNTS8 = SENDCOUNTS
  SDISPLS8 = SDISPLS
  SENDTYPE8 = SENDTYPE
  RECVCOUNTS8 = RECVCOUNTS
  RDISPLS8 = RDISPLS
  RECVTYPE8 = RECVTYPE
  COMM8 = COMM

  CALL MPI_ALLTOALLV( &
      #{if cast(ranksuff)}# SENDAREA8 #{else}# SENDAREA #{endif}#, &
      SENDCOUNTS8, SDISPLS8, SENDTYPE8,  &
      #{if cast(ranksuff)}# RECVAREA8 #{else}# RECVAREA #{endif}#, &
      RECVCOUNTS8, RDISPLS8, RECVTYPE8, COMM8, IERROR8)

#:if cast(ranksuff)
  RECVAREA=RECVAREA8
#:endif
  IERROR = IERROR8


#:if is_allocatable(ranksuff)
  DEALLOCATE(SENDAREA8)
  DEALLOCATE(READAREA8)
#:endif
  DEALLOCATE(SENDCOUNTS8)
  DEALLOCATE(SDISPLS8)
  DEALLOCATE(RECVCOUNTS8)
  DEALLOCATE(RDISPLS8)

END SUBROUTINE MPI_ALLTOALLV8_${ranksuff}$

! ---------------------------------------------------------

#:endfor
 
! =========================================================

#:for ranksuff in bcast_ranksuffs

SUBROUTINE MPI_BCAST8_${ranksuff}$(DATA, COUNT, DATATYPE, ROOT, COMM, IERROR)

  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(INOUT) :: &
    DATA
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    COUNT, DATATYPE, ROOT, COMM
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

  INTEGER(KIND=8) :: &
    COUNT8, DATATYPE8, ROOT8, COMM8, IERROR8

#:if is_allocatable(ranksuff)
  ALLOCATE(DATA8(SIZE(DATA)))  
#:endif

#:if cast(ranksuff)
  DATA8 = DATA
#:endif
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE
  ROOT8 = ROOT
  COMM8 = COMM

  CALL MPI_BCAST(#{if cast(ranksuff)}# DATA8 #{else}# DATA #{endif}#, &
     COUNT8, DATATYPE8, ROOT8, COMM8, IERROR8)

  IERROR = IERROR8

#:if is_allocatable(ranksuff)
  DEALLOCATE(DATA8)
#:endif

END SUBROUTINE MPI_BCAST8_${ranksuff}$

! ---------------------------------------------------------

#:endfor

! =========================================================

#:for ranksuff in sendrecv_ranksuffs
        
SUBROUTINE MPI_BSEND8_${ranksuff}$(DATA, COUNT, DATATYPE, DEST, TAG, COMM, IERROR)

  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(IN) :: &
    DATA
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    COUNT, DATATYPE, DEST, TAG, COMM
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
    DATA8
  INTEGER(KIND=8) :: &
    COUNT8, DATATYPE8, DEST8, TAG8, COMM8, IERROR8

#:if allocatable(ranksuff)
  ALLOCATE(DATA8(SIZE(DATA)))
#:endif

#:if cast(ranksuff)
  DATA8 = DATA
#:endif  
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE
  DEST8 = DEST
  TAG8 = TAG
  COMM8 = COMM

      CALL MPI_BSEND(#{if cast(ranksuff)}# DATA8 #{else}# DATA #{endif}#, &
        COUNT8, DATATYPE8, DEST8, TAG8, COMM8, IERROR8)

  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(DATA8)
#:endif

END SUBROUTINE MPI_BSEND8_${ranksuff}

! ---------------------------------------------------------
      
SUBROUTINE MPI_ISEND8_${ranksuff}$ (DATA, COUNT, DATATYPE, DEST, TAG, COMM, REQUEST, IERROR)

  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(IN) :: &
    DATA
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    COUNT, DATATYPE, DEST, TAG, COMM
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    REQUEST, IERROR

  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
    DATA8
  INTEGER(KIND=8) :: &
    COUNT8, DATATYPE8, DEST8, TAG8, COMM8, REQUEST8, IERROR8

#:if allocatable(ranksuff)
  ALLOCATE(DATA8(SIZE(DATA)))
#:endif      

#:if cast(ranksuff)
  DATA8 = DATA
#:endif
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE
  DEST8 = DEST
  TAG8 = TAG
  COMM8 = COMM

  CALL MPI_ISEND(#{if cast(ranksuff)}# DATA8 #{else}# DATA #{endif}#, &
      COUNT8, DATATYPE8, DEST8, TAG8, COMM8, REQUEST8, IERROR8)

  REQUEST = REQUEST8
  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(DATA8)
#:endif
      
END SUBROUTINE MPI_ISEND8_${ranksuff}$

! ---------------------------------------------------------

SUBROUTINE MPI_SEND8_${ranksuff} (DATA, COUNT, DATATYPE, DEST, TAG, COMM, IERROR)

  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(IN) :: &
    DATA
  INTEGER(KIND=JPIM), INTENT(IN) :: &
    COUNT, DATATYPE, DEST, TAG, COMM
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
    DATA8
  INTEGER(KIND=8) :: &
    COUNT8, DATATYPE8, DEST8, TAG8, COMM8, IERROR8

#:if allocatable(ranksuff)
  ALLOCATE(DATA8(SIZE(DATA)))
#:endif

#:if cast(ranksuff)
  DATA8 = DATA
#:endif
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE
  DEST8 = DEST
  TAG8 = TAG
  COMM8 = COMM

  CALL MPI_SEND(#{if cast(ranksuff)}# DATA8 #{else}# DATA #{endif}#, &
      COUNT8, DATATYPE8, DEST8, TAG8, COMM8, IERROR8)

  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(DATA8)
#:endif
      
END SUBROUTINE MPI_SEND8_${ranksuff}

#:endfor
      
! =========================================================

#:for ranksuff in mpifile_ranksuffs
#:for method in ['IREAD_SHARED','IWRITE_SHARED']    
SUBROUTINE MPI_FILE_${method}$8_${ranksuff}$(FH, BUF, COUNT, DATATYPE, REQUEST, IERROR)

  INTEGER(KIND=JPIM), INTENT(IN) :: &
    FH, COUNT, DATATYPE
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(OUT) :: &
    BUF
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    REQUEST, IERROR

  INTEGER(KIND=8) :: &
    FH8, COUNT8, DATARANKSUFF8, REQUEST8, IERROR8

  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
      BUF8

#:if allocatable(ranksuff)
  ALLOCATE(BUF8(SIZE(BUF)))
#:endif
      
  FH8 = FH
  COUNT8 = COUNT     
  DATATYPE8 = DATATYPE

  CALL MPI_FILE_${method}$(FH8, &
      #{if cast(ranksuff)}# BUF8 #{else}# BUF #{endif}#, &
      COUNT8, DATATYPE8, REQUEST8, IERROR8)

#:if cast(ranksuff)
      BUF = BUF8
#:endif
      
  REQUEST = REQUEST8
  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(BUF8)
#:endif
      
END SUBROUTINE MPI_FILE_${method}$8_${ranksuff}$

#:endfor

#:for method in ['READ_ORDERED', 'READ_SHARED']
! ---------------------------------------------------------
SUBROUTINE MPI_FILE_${method}$8_${ranksuff}$(FH, BUF, COUNT, DATATYPE, STATUS, IERROR)

  INTEGER(KIND=JPIM), INTENT(IN) :: &
    FH, COUNT, DATATYPE
  ${kind(ranksuff)}$ ${dim(ranksuff)}$ INTENT(OUT) :: &
    BUF
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    STATUS(:), IERROR

      
  INTEGER(KIND=8) :: &
    FH8, COUNT8, DATATYPE8, IERROR8

#:if allocatable(ranksuff)
  ${kind(ranksuff)}$ ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
      BUF8
#:endif      
      
  FH8 = FH
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE

  CALL MPI_FILE_${method}$(FH8, &
      #{if cast(ranksuff)}# BUF8 #{else}# BUF #{endif}#, &
      COUNT8, DATATYPE8, STATUS8, IERROR8)

#:if cast(ranksuff)
      BUF=BUF8
#:endif      
  STATUS = STATUS8
  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(BUF8)
#:endif

END SUBROUTINE MPI_FILE_${method}$_${ranksuff}$8_R8

#:endfor
      
#:for method in ['WRITE_ORDERED', 'WRITE_SHARED']
! ---------------------------------------------------------
SUBROUTINE MPI_FILE_${method}$8_${ranksuff}$(FH, BUF, COUNT, DATATYPE, STATUS, IERROR)

  INTEGER(KIND=JPIM), INTENT(IN) :: &
    FH, COUNT, DATATYPE
  ${kind(ranksuff)}$ ${dim(ranksuff)}$ INTENT(IN) :: &
    BUF
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    STATUS(:), IERROR
      
  INTEGER(KIND=8) :: &
    FH8, COUNT8, DATATYPE8, IERROR8

#:if allocatable(ranksuff)
  ${base_kind(ranksuff)}$(KIND=8) ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
      BUF8
#:endif      
      
  FH8 = FH
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE
#:if cast(ranksuff)
  BUF8=BUF
#:endif
      
  CALL MPI_FILE_${method}$(FH8, &
      #{if cast(ranksuff)}# BUF8 #{else}# BUF #{endif}#, &
      COUNT8, DATATYPE8, STATUS8, IERROR8)

  STATUS = STATUS8
  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(BUF8)
#:endif

END SUBROUTINE MPI_FILE_${method}$_${ranksuff}$8_R8

#:endfor
      

! ---------------------------------------------------------
SUBROUTINE MPI_FREAD_ORDERED_BEGIN8_${ranksuff}$(FH, BUF, COUNT, DATATYPE, IERROR)

  INTEGER(KIND=JPIM), INTENT(IN) :: &
    FH, COUNT, DATATYPE
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ INTENT(OUT) :: &
    BUF
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR

  INTEGER(KIND=8) :: &
    FH8, COUNT8, DATATYPE8, IERROR8
  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$  :: &
      BUF8

#:if allocatable(ranksuff)
   ALLOCATE(BUF8(SIZE(BUF)))
#:endif
#:if cast(ranksuff)
  BUF8=BUF
#:endif      
  FH8 = FH
  COUNT8 = COUNT
  DATATYPE8 = DATATYPE

  CALL MPI_FILE_READ_ORDERED_BEGIN(FH8, &
      #{if cast(ranksuff)}# BUF8 #{else}# BUF #{endif}#, &
      COUNT8, DATATYPE8, IERROR8)

#:if cast(ranksuff)
  BUF = BUF8
#:endif
#:if allocatable(ranksuff)
  DEALLOCATE(BUF8)
#:endif
      
  IERROR = IERROR8

END SUBROUTINE MPI_FREAD_ORDERED_BEGIN8_${ranksuff}$

! ---------------------------------------------------------
SUBROUTINE MPI_FREAD_ORDERED_END8_${ranksuff}$(FH, BUF, STATUS, IERROR)

  INTEGER(KIND=JPIM), INTENT(IN) :: &
    FH
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
      STATUS(:), IERROR
  ${kind(ranksuff)}$, ${dim(ranksuff)}$ , INTENT(OUT) :: &
      BUF
     
  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ALLOCATABLE :: &
    BUF8
  INTEGER(KIND=8) :: &
    FH8, IERROR8

#:if allocatable(ranksuff)
  ALLOCATE(BUF8(SIZE(BUF)))
#:endif
      
  FH8 = FH

  CALL MPI_FILE_READ_ORDERED_END(FH8, &
      #{if cast(ranksuff)}# BUF8 #{else}# BUF #{endif}#,
      STATUS8, IERROR8)

#:if cast(ranksuff)
  BUF = BUF8
#:endif      
  STATUS = STATUS8
  IERROR = IERROR8

#:if allocatable(ranksuff)
  DEALLOCATE(BUF8)
#:endif
      
END SUBROUTINE MPI_FREAD_ORDERED_END8_${ranksuff}$

! ---------------------------------------------------------
SUBROUTINE MPI_FWRITE_ORDERED_BEGIN8_${ranksuff}$(FH, BUF, COUNT, DATATYPE, IERROR)

  INTEGER(KIND=JPIM), INTENT(IN) :: &
    FH, COUNT, DATATYPE
  ${kind(ranksuff)}$ ${dim(ranksuff)$ INTENT(OUT) :: &
    BUF
  INTEGER(KIND=JPIM), INTENT(OUT) :: &
    IERROR
  INTEGER(KIND=8) :: &
    FH8, COUNT8, DATATYPE8, IERROR8

#:if allocatable(ranksuff)
  ${base_kind(ranksuff)}$(KIND=8), ${dim(ranksuff)}$ ${allocatable(ranksuff)}$ :: &
    BUF8
  ALLOCATE(BUF8(SIZE(BUF)))
#:endif
      
