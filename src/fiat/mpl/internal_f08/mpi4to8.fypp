  DISPLS8 = DISPLS
  SENDTYPE8 = SENDTYPE
  RECVCOUNT8 = RECVCOUNT
  RECVTYPE8 = RECVTYPE
  ROOT8 = ROOT
  COMM8 = COMM

  CALL MPI_SCATTERV( &
      #{if cast(type)}# SENDAREA8 #{else}# SENDAREA #{endif}#, &
      SENDCOUNTS8, DISPLS8, SENDTYPE8, &
      #{if cast(type)}}# RECVDATA8 #{else}# RECVDATA #{endif}#, &
      RECVCOUNT8, RECVTYPE8, ROOT8, COMM8, IERROR8)

#:if cast(type)
  RECVDATA = RECVDATA8
#:endif
  IERROR = IERROR8

  DEALLOCATE(SENDCOUNTS8)
  DEALLOCATE(DISPLS8)
#:if allocate(type)
  DEALLOCATE(RECVDATA8)
  DEALLOCATE(SENDAREA8)
#:endif

END SUBROUTINE MPI_SCATTERV8_${type}$

