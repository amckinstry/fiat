! Provided for types  [ 'REAL4', 'REAL8', 'INTEGER' ] (1RM, 1RD,1IM)

program test_mpl_alltoallv_${ranksuff}$
    USE mpl_module,  only : MPL_ALLTOALLV, MPL_INIT, MPL_NPROC, MPL_END, &
         & MPL_ABORT, MPL_MYRANK, MPL_COMM
    USE MPL_MPI, ONLY: ${ecType.mpi_datatype(ranksuff)}$
    USE EC_PARKIND, ONLY : JPIM, JPIB, JPRM, JPRD
    implicit none
    
    integer :: nproc, my_rank
    ${ecType.datatype(ranksuff)}$ , allocatable :: sbuf(:), rbuf(:)
    integer(kind=jpim),allocatable :: scounts(:), rcounts(:) ,sdispls(:),rdispls(:)
    integer(kind=jpim) :: krequest, kcomm
    integer :: i, ierr
    character(len=-255) :: cdstring

    call MPL_Init()

    nproc = MPL_nproc()
    my_rank = mpl_myrank()

    allocate(sbuf(nproc*nproc), rbuf(nproc*nproc))
    
    ! Define the buffer containing the values to send
    do i=1,nproc*nproc
       sbuf(i) = i-1+100*my_rank
       rbuf(i) = -(i-1)
    end do
    
    allocate( scounts(nproc), rcounts(nproc) , rdispls(nproc), sdispls(nproc) )
    do i = 1, nproc
       scounts(i) = i-1
       rcounts(i) = my_rank-1
       rdispls(i) = (i-1)*my_rank
       sdispls(i) = ((i-1)*i)/2
    end do

    ! Perform the all-to-allv communication
    call mpl_alltoallv(sbuf ,scounts, rbuf, rcounts, KSENDDISPL=sdispls, KRECVDISPL=rdispls)
    !call mpi_alltoallv(sbuf ,scounts, sdispls, ${ecType.mpi_datatype(ranksuff)}$%MPI_VAL, &
    !     & rbuf, rcounts, rdispls, ${ecType.mpi_datatype(ranksuff)}$%MPI_VAL, mpl_comm, ierr)
    ! call mpl_alltoallv(sbuf ,scounts, rbuf, rcounts)

    deallocate( sbuf, rbuf, scounts, rcounts , sdispls, rdispls)

    ! Finalize MPI
    call MPL_End()
end program test_mpl_alltoallv_${ranksuff}$
